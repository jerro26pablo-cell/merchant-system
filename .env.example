# Development Environment Variables (DO NOT COMMIT THIS FILE)
# Copy this file to .env and fill in your local development values

# Security
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Use DATABASE_URL for production, or individual variables for local
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_NAME=django_merchant
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (if using Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (optional for development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@django-merchant.com

# Production Override (Render sets these automatically)
# DEBUG=False (Render)
# DATABASE_URL (Render - from database connection)
# ALLOWED_HOSTS=*.onrender.com (Render)
# SECRET_KEY (Render - auto-generated)
